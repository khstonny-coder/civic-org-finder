// 단체의 "분야" 판정 (PLAN 작업 5번).
// 자료에는 분야 항목이 없고 사업내용(자유 문장)만 있어서, 단체명·사업내용에 나온 키워드로 분야를 정한다.
// - 여러 분야의 키워드가 섞이면 가장 많이 맞는 분야 한 개, 동점이면 아래 목록에서 앞에 있는 분야
// - 하나도 맞지 않으면 "기타"

export const FIELD_NAMES = [
  "환경",
  "복지·돌봄",
  "교육·청소년",
  "문화·예술",
  "인권·평화",
  "여성·가족·다문화",
  "안전·방범",
  "경제·일자리",
  "지역사회·자원봉사",
  "기타",
] as const;

export type FieldName = (typeof FIELD_NAMES)[number];

const KEYWORDS: Record<Exclude<FieldName, "기타">, string[]> = {
  환경: ["환경", "생태", "자연보호", "녹색", "하천", "산림", "에너지", "기후", "재활용", "자원순환", "야생", "수질", "쓰레기", "친환경", "탄소"],
  "복지·돌봄": ["복지", "돌봄", "장애인", "노인", "어르신", "저소득", "취약계층", "불우이웃", "급식", "요양", "자립생활", "아동", "후원", "나눔"],
  "교육·청소년": ["교육", "청소년", "학교", "학생", "진로", "방과후", "독서", "학습"],
  "문화·예술": ["문화", "예술", "공연", "음악", "전시", "미술", "무용", "문학", "전통", "축제", "영화"],
  "인권·평화": ["인권", "평화", "통일", "민주", "권익", "반부패", "투명", "감시"],
  "여성·가족·다문화": ["여성", "가족", "다문화", "이주", "결혼이민", "한부모", "육아", "보육", "양성평등"],
  "안전·방범": ["안전", "방범", "순찰", "재난", "구조", "소방", "교통", "질서", "방재", "예방"],
  "경제·일자리": ["일자리", "취업", "창업", "경제", "소상공", "농업", "귀농", "상생", "소비자", "실업"],
  "지역사회·자원봉사": ["자원봉사", "봉사", "지역사회", "마을", "새마을", "바르게살기", "주민", "공동체", "지역발전"],
};

export function classifyField(name: string, description: string | null): FieldName {
  const text = `${name} ${description ?? ""}`;
  let best: FieldName = "기타";
  let bestScore = 0;
  for (const field of FIELD_NAMES) {
    if (field === "기타") continue;
    const score = KEYWORDS[field].filter((k) => text.includes(k)).length;
    if (score > bestScore) {
      best = field;
      bestScore = score;
    }
  }
  return best;
}
