# 환경변수 예시 (PLAN 작업 23번). 값은 비워 둔 목록이다. 실제 값은 `.env`(내 컴퓨터)와 Vercel 환경변수 화면에만 넣는다.
# 이 파일에는 절대 실제 값을 적지 않는다.

# ── Supabase (화면·서버) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 (절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다) ──
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# ── 선택 ──
# AI 모델 이름 (없으면 gpt-4o-mini)
OPENAI_MODEL=
# 공무원 가입을 허용할 추가 도메인 (쉼표로 구분, go.kr·korea.kr은 항상 허용)
ALLOWED_EMAIL_DOMAINS=
# 배포 주소 (인증 메일의 돌아올 주소로 쓴다). 예: https://내서비스.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── 작업용 도구 전용: 내 컴퓨터의 .env에만 두고 Vercel에는 등록하지 않는다 ──
# 경기데이터드림 인증키 (전체 수집 npm run collect:full 에서만 사용)
GG_OPENAPI_KEY=
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD, VERCEL_TOKEN, GITHUB_TOKEN
